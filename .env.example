NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://app_user:replace-me@localhost:5432/esg_sustainability_db
JWT_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
EXPOSE_DEMO_TOKENS=false
ALLOW_SELF_REGISTRATION=false
ENABLE_LEGACY_PROTOTYPE_ROUTES=false
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
